# Keep the real key only in .env.local or your hosting provider's secret settings.
OPENAI_API_KEY=
# Optional: choose a model available to your OpenAI API account.
OPENAI_MODEL=gpt-5.4-mini
# Optional: classroom-safe live AI wait limit in milliseconds (clamped to 5-60 seconds).
OPENAI_TIMEOUT_MS=45000
# Optional public-demo safeguards. In-memory defaults are shown below.
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=20
AI_GLOBAL_DAILY_REQUEST_LIMIT=100
AI_CONCURRENT_PER_VISITOR=1
AI_GLOBAL_CONCURRENT_LIMIT=3
