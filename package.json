{
  "name": "thinkrevise-ai-chinese",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:data": "NODE_NO_WARNINGS=1 node --experimental-strip-types scripts/check-learning-data.mjs",
    "check:limits": "NODE_NO_WARNINGS=1 node --experimental-strip-types scripts/check-text-limits.mjs",
    "check:copy": "node scripts/check-chinese-ui.mjs",
    "check:safeguards": "node scripts/check-safeguards.mjs && node scripts/check-revision-consistency.mjs",
    "check:security": "NODE_NO_WARNINGS=1 node --experimental-strip-types scripts/check-security-controls.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "benchmark:validate": "node scripts/benchmark-accuracy.mjs",
    "benchmark:live": "node scripts/benchmark-accuracy.mjs",
    "test:accuracy-stability": "node scripts/check-live-academic-stability.mjs",
    "benchmark:academic-validate": "node scripts/check-live-academic-stability.mjs",
    "benchmark:longform-validate": "node scripts/check-longform-academic.mjs",
    "test:longform-live": "node scripts/check-longform-academic.mjs",
    "test:demo": "node --experimental-strip-types scripts/check-demo-validation.mjs",
    "test:demo:live": "node scripts/check-demo-live.mjs",
    "test:api": "node scripts/check-api.mjs",
    "test:recovery": "node scripts/check-boundary-recovery.mjs",
    "test:live-ai": "node scripts/check-live-ai.mjs",
    "verify": "npm run lint && npm run check:data && npm run check:limits && npm run check:copy && npm run check:safeguards && npm run check:security && npm run benchmark:validate && npm run benchmark:academic-validate && npm run benchmark:longform-validate && npm run build",
    "verify:release": "npm run verify && node scripts/run-local-release-suite.mjs && npm run check:release"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
